# Copy this file to .env on the computer that runs `npm run photos:sync`.
# Never commit the real .env file.

IMMICH_URL=http://immich.local:2283
IMMICH_API_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aperture-photos
PHOTOS_BASE_URL=https://photos.the-aperture.app

# On Vercel only: when set, the site reads the manifest from R2 instead of
# content/photos.json, so new photos appear without a redeploy.
# PHOTOS_MANIFEST_URL=https://photos.the-aperture.app/manifest.json

# Grid size in km for the coarse location map in the manifest (default 5).
# LOCATION_GRID_KM=5
